# Copy to `.env` and fill in. `.env` is gitignored. Real env vars override `.env`.

# ── Anthropic API (judges + LLM agent) ──
ANTHROPIC_API_KEY=

# ── Agent under test ──
AGENT_MODE=auto              # auto | llm | offline
AGENT_MODEL=claude-opus-4-8

# ── Judges ──
JUDGE_MODE=auto              # auto | llm | offline
JUDGE_MODEL=claude-opus-4-8
JUDGE_EFFORT=medium          # low | medium | high
JUDGE_CONCURRENCY=6

# ── MCP integration (backs MCPClear / get_transactions) ──
# fixture = read data/mcp_fake.json + fixtures/operations.json (default, offline)
# live    = call a real MCP server (needs: pip install mcp)
MCP_MODE=fixture             # fixture | live
MCP_TRANSPORT=stdio          # stdio | http
MCP_SERVER_URL=              # http, e.g. https://mcp.internal/transactions
MCP_COMMAND=                 # stdio, e.g. python3 mcp_server.py
MCP_TOOL_NAME=get_transactions
MCP_AUTH_TOKEN=              # optional bearer token for http transport
