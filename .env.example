# Secrets + optional overrides. Copy to `.env` (gitignored). Real env vars override `.env`.
# Endpoints, models, and prompts live in agents.toml — one [section] per agent.

# API keys — each agent's api_key_env (in agents.toml) points at one of these.
# Any unset key falls back to ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
AGENT_API_KEY=          # the support agent under test
JUDGE_API_KEY=          # the groundedness + resolution judges
SANDBOX_API_KEY=        # Alfa Sandbox API (AlfaGen) — the UUID key issued by email per
                        # "4. Sandbox API.pdf"; agents.toml points all roles here by default.
                        # VPN/VDI network only; access expires after 3 months (request renewal).
DEEPSEEK_API_KEY=       # direct DeepSeek (external alternative for the judges)

# Optional per-role mode overrides (auto | llm | offline) — else from agents.toml
# AGENT_MODE=
# GROUNDEDNESS_MODE=
# RESOLUTION_MODE=

# Optional per-role TLS overrides ({ROLE}_ prefix: AGENT_/GROUNDEDNESS_/RESOLUTION_/SCOPE_).
# insecure=1 skips certificate verification (curl -k — the Sandbox cert is self-signed);
# 0 forces verification back on; CA_BUNDLE verifies against the bank CA PEM instead.
# RESOLUTION_INSECURE=1
# RESOLUTION_CA_BUNDLE=certs/alfa_ca.pem

# Optional MCP overrides — else from agents.toml [mcp]
# MCP_MODE=live
# MCP_COMMAND=python3 mcp_server.py
